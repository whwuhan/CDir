<UserControl x:Class="CDir.UI.WorkspacePaneView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:CDir.Services" Focusable="False">
  <Grid ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border x:Name="TabBar" Grid.Row="0" Background="{StaticResource SurfaceOuter}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,2,6,0" PreviewMouseDown="TabBarPreviewMouseDown">
        <StackPanel>
          <Border x:Name="PinnedTabRow" Visibility="Collapsed" Background="Transparent" AllowDrop="True" PreviewDragEnter="TabRowDragOver" PreviewDragOver="TabRowDragOver" PreviewDragLeave="TabRowDragLeave" PreviewDrop="TabRowDrop">
            <Grid>
          <ScrollViewer x:Name="PinnedTabScroll" services:ScrollBarReveal.IsEnabled="True" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" Margin="0,0,0,2">
            <ItemsControl x:Name="PinnedTabHeaders" ItemTemplate="{DynamicResource TabHeaderTemplate}" ItemsSource="{Binding PinnedHeaders, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
              <Border x:Name="PinnedTabDropMarker" Width="2" HorizontalAlignment="Left" Background="{StaticResource Accent}" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
          </Border>
          <Border x:Name="NormalTabRow" Background="Transparent" AllowDrop="True" PreviewDragEnter="TabRowDragOver" PreviewDragOver="TabRowDragOver" PreviewDragLeave="TabRowDragLeave" PreviewDrop="TabRowDrop">
            <Grid>
          <ScrollViewer x:Name="TabScroll" services:ScrollBarReveal.IsEnabled="True" Background="Transparent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <ItemsControl x:Name="TabHeaders" ItemTemplate="{DynamicResource TabHeaderTemplate}" ItemsSource="{Binding VisibleHeaders, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
              <Button x:Name="NewTabButton" Content="+" Width="24" Height="24" Margin="4,0,0,1" FontSize="18" Padding="0" VerticalAlignment="Top"
                      Click="NewTabClick" ToolTip="{DynamicResource TextNewTab}" AutomationProperties.Name="{DynamicResource TextNewTab}" />
            </StackPanel>
          </ScrollViewer>
              <Border x:Name="NormalTabDropMarker" Width="2" HorizontalAlignment="Left" Background="{StaticResource Accent}" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <Grid x:Name="TabPages" Grid.Row="1" />
    <Border x:Name="SplitPreview" Grid.RowSpan="2" Panel.ZIndex="100" Background="#48549FE8" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed" Margin="3" />
  </Grid>
</UserControl>
