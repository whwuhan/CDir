<Window x:Class="CDir.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:CDir.Models" xmlns:controls="clr-namespace:CDir.Controls" xmlns:services="clr-namespace:CDir.Services" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        FontWeight="{DynamicResource UIFontWeight}" Title="{DynamicResource TextWindowTitle}" Icon="/CDir;component/Resource/App.ico" Width="1280" Height="820" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="WindowPreviewKeyDown" PreviewMouseWheel="WindowPreviewMouseWheel" PreviewMouseDown="WindowInputPreviewMouseDown" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="{DynamicResource UITitleControlHeight}" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TabContextMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FileMenuShortcutItem" TargetType="MenuItem" BasedOn="{StaticResource TabContextMenuItem}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            <TextBlock x:Name="ShortcutHint" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /><Setter TargetName="ShortcutHint" Property="Foreground" Value="#DCEEFF" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /><Setter TargetName="ShortcutHint" Property="Foreground" Value="#DCEEFF" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WindowCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <!-- Native caption actions do not retain keyboard focus after a click or tray restore. -->
      <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="{DynamicResource UITitleControlHeight}" />
      <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="9" />
    </Style>
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource CloseHover}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ClosePressed}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TabPinButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Page.IsTabPinned}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="TabHeaderTemplate">
                <Border x:Name="TabSurface" PreviewMouseLeftButtonDown="TabHeaderDragMouseDown" PreviewMouseMove="TabHeaderDragMouseMove" PreviewMouseLeftButtonUp="TabHeaderDragMouseUp" Height="{DynamicResource UITabHeight}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" Margin="0,0,3,0" Background="{StaticResource SurfaceOuter}">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource UIFontMenus}" Padding="2" Opened="TabContextMenuOpened">
                      <ContextMenu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource TabContextMenuItem}" />
                        <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"><Setter Property="Margin" Value="4,2" /></Style>
                      </ContextMenu.Resources>
                      <MenuItem Tag="RenameTab" Header="{DynamicResource TextRenameTab}" Click="RenameTabClick" />
                      <Separator />
                      <MenuItem Tag="CloseRightTabs" Header="{DynamicResource TextCloseRightTabs}" Click="CloseTabsMenuClick" />
                      <MenuItem Tag="CloseLeftTabs" Header="{DynamicResource TextCloseLeftTabs}" Click="CloseTabsMenuClick" />
                      <MenuItem Tag="CloseOtherTabs" Header="{DynamicResource TextCloseOtherTabs}" Click="CloseTabsMenuClick" />
                      <Separator />
                      <MenuItem Tag="CloseTab" Header="{DynamicResource TextCloseTab}" Click="CloseTabsMenuClick" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                    <Button Click="SelectTabClick" Padding="6,2" MinWidth="78" MaxWidth="190" HorizontalContentAlignment="Left" ToolTip="{Binding Page.TabPath}" AutomationProperties.Name="{Binding Page.TabTitle}">
                      <StackPanel Orientation="Horizontal">
                        <controls:ShellIcon Path="{Binding Page.TabPath}" IsDirectory="True" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Page.TabTitle}" TextTrimming="CharacterEllipsis" MaxWidth="135" FontSize="{DynamicResource UIFontTabs}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="PinTabButton" Style="{StaticResource TabPinButtonStyle}" Grid.Column="1" Content="&#xE718;" Click="PinTabClick" Width="20" Height="20" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="0" VerticalAlignment="Center" Focusable="False"
                            ToolTip="{DynamicResource TextPinTab}" AutomationProperties.Name="{DynamicResource TextPinTab}" />
                    <Button x:Name="CloseTabButton" Style="{StaticResource WindowCloseButton}" Grid.Column="2" Content="&#xE8BB;" Click="CloseTabClick" Width="20" Height="20" FontSize="10" Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"
                            ToolTip="{DynamicResource TextCloseTab}" AutomationProperties.Name="{DynamicResource TextCloseTab}" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers><DataTrigger Binding="{Binding Page.IsTabSelected}" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceInner}" />
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
                  <DataTrigger Binding="{Binding Page.IsTabPinned}" Value="True">
                    <Setter TargetName="PinTabButton" Property="Content" Value="&#xE77A;" />
                    <Setter TargetName="PinTabButton" Property="ToolTip" Value="{DynamicResource TextUnpinTab}" />
                    <Setter TargetName="PinTabButton" Property="AutomationProperties.Name" Value="{DynamicResource TextUnpinTab}" />
                  </DataTrigger></DataTemplate.Triggers>
              </DataTemplate>
  </Window.Resources>
  <Border x:Name="WindowFrame" Background="{StaticResource SurfaceOuter}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="{DynamicResource UITitleRowHeight}" /><RowDefinition Height="{DynamicResource UIMenuRowHeight}" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="{StaticResource SurfaceOuter}">
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Image x:Name="TitleIcon" Source="/CDir;component/Resource/App.ico" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleBrand" Text="CDir" FontSize="{DynamicResource UIFontTitleBar}" FontWeight="{DynamicResource UIHeadingFontWeight}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleVersion" FontSize="{DynamicResource UIFontTitleBar}" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowCaptionButton}" Content="&#xE921;" ToolTip="{DynamicResource TextMinimize}" AutomationProperties.Name="{DynamicResource TextMinimize}" Click="MinimizeClick" />
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButton}" Content="&#xE922;" ToolTip="{DynamicResource TextMaximizeRestore}" AutomationProperties.Name="{DynamicResource TextMaximizeRestore}" Click="MaximizeClick" />
          <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" FontSize="10" Content="&#xE8BB;" ToolTip="{DynamicResource TextClose}" AutomationProperties.Name="{DynamicResource TextClose}" Click="CloseClick" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource SurfaceOuter}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FileMenuButton" Content="{DynamicResource TextFileMenu}" AutomationProperties.Name="{DynamicResource TextFileMenu}" FontSize="{DynamicResource UIFontMenus}" Padding="8,1" Click="FileMenuClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Button.ContextMenu>
              <ContextMenu x:Name="FileMenu" Placement="Bottom" VerticalOffset="2" MinWidth="{DynamicResource UIMenuMinimumWidth}" Background="{StaticResource SurfaceInner}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                <ContextMenu.Template>
                  <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="0">
                      <ItemsPresenter />
                    </Border>
                  </ControlTemplate>
                </ContextMenu.Template>
                <MenuItem x:Name="UndoMenuItem" Tag="Undo" Header="{DynamicResource TextUndo}" InputGestureText="Ctrl+Z" Style="{StaticResource FileMenuShortcutItem}" Click="UndoClick" />
                <MenuItem x:Name="RedoMenuItem" Tag="Redo" Header="{DynamicResource TextRedo}" InputGestureText="Ctrl+Y" Style="{StaticResource FileMenuShortcutItem}" Click="RedoClick" />
                <Separator x:Name="FileMenuSeparator" Style="{StaticResource {x:Type Separator}}" />
                <MenuItem x:Name="PreferencesMenuItem" Tag="Preferences" Header="{DynamicResource TextPreferences}" Style="{StaticResource FileMenuShortcutItem}" Click="PreferencesClick" />
                <Separator x:Name="FileMenuExitSeparator" Style="{StaticResource {x:Type Separator}}" />
                <MenuItem x:Name="ExitMenuItem" Tag="TrayExit" Header="{DynamicResource TextTrayExit}" Style="{StaticResource TabContextMenuItem}" Click="ExitClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="HelpMenuButton" Content="{DynamicResource TextHelpMenu}" AutomationProperties.Name="{DynamicResource TextHelpMenu}" FontSize="{DynamicResource UIFontMenus}" Padding="8,1" Click="HelpMenuClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Button.ContextMenu>
              <ContextMenu x:Name="HelpMenu" Placement="Bottom" VerticalOffset="2" MinWidth="{DynamicResource UIMenuMinimumWidth}" Padding="2">
                <ContextMenu.Template>
                  <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="0"><ItemsPresenter /></Border>
                  </ControlTemplate>
                </ContextMenu.Template>
                <MenuItem x:Name="AboutMenuItem" Tag="About" Header="{DynamicResource TextAbout}" Style="{StaticResource TabContextMenuItem}" Click="AboutClick" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Border>
      <Grid x:Name="WorkspaceSurface" Grid.Row="2" Grid.RowSpan="2" />
    </Grid>
  </Border>
</Window>
