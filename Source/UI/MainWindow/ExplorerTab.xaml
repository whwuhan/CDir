<UserControl x:Class="CDir.UI.ExplorerTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:CDir.Models" xmlns:controls="clr-namespace:CDir.Controls" xmlns:services="clr-namespace:CDir.Services" FontWeight="{DynamicResource UIFontWeight}" Loaded="WindowLoaded">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/CDir;component/Resource/CategoryFolderIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ColumnToggleMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="MenuSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            <TextBlock x:Name="CheckMark" Grid.Column="1" Text="√" Margin="12,0,0,0" Visibility="Hidden" VerticalAlignment="Center" />
            <TextBlock x:Name="SubmenuArrow" Grid.Column="1" Text="›" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
            <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=MenuSurface}"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
              <Border Background="{StaticResource SurfaceInner}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="HasItems" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" /><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <controls:DriveColumnGroupConverter x:Key="DriveColumnGroup" />
    <controls:TreeIndentConverter x:Key="TreeIndent" />
    <Style x:Key="SidebarFolderPath" TargetType="TextBlock">
      <Setter Property="Text" Value="{Binding FullPath}" />
      <Setter Property="Margin" Value="12,0,4,0" /><Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="{DynamicResource UIFontSidebar}" />
      <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding FullPath}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="0" /><Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowBookmarkPaths, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="BookmarkFolderContent">
      <Grid ClipToBounds="True" controls:SidebarPathColumns.IsEnabled="{Binding ShowBookmarkPaths, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="PathColumn" Width="0" /></Grid.ColumnDefinitions>
        <controls:ShellIcon Path="{Binding FullPath}" VersionStatus="{Binding VersionStatus}" IsDirectory="True" OpenFolder="{Binding IsExpanded}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="BookmarkPath" Grid.Column="2" Style="{StaticResource SidebarFolderPath}"
                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Grid>

    </DataTemplate>
    <ControlTemplate x:Key="DriveUsageBarTemplate" TargetType="ProgressBar">
      <Grid ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True" Effect="{x:Null}">
        <Border Background="{TemplateBinding Background}" />
        <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" /></Grid>
        <Border x:Name="UsageFrame" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" />
      </Grid>
    </ControlTemplate>
    <Style x:Key="DriveUsageMeter" TargetType="ProgressBar">
      <Setter Property="Height" Value="9" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{StaticResource SurfaceInner}" /><Setter Property="BorderBrush" Value="{StaticResource NeutralIndicator}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource DriveUsageLow}" /><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template" Value="{StaticResource DriveUsageBarTemplate}" />
    </Style>
    <Style x:Key="WindowCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="36" /><Setter Property="Height" Value="{DynamicResource UITitleControlHeight}" />
      <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="9" />
    </Style>
    <Style x:Key="CategoryFolderAction" TargetType="Button">
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="4" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ActionSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{StaticResource SurfaceHover}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{StaticResource SurfacePressed}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{StaticResource FocusOutline}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="CategoryFolderActionIcon" TargetType="Image">
      <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CategoryHeaderToggle}" Value="True"><Setter Property="Source" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsPressed, ElementName=CategoryHeaderToggle}" Value="True"><Setter Property="Source" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarFolderHeader" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
      <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SidebarHover}" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SidebarHover}" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressed}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
          <DataTrigger Binding="{Binding Node.IsSelected}" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource TreeSelected}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SidebarSection" TargetType="Expander">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
              <ToggleButton x:Name="CategoryHeaderToggle" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                            FontWeight="{DynamicResource UIHeadingFontWeight}" FontSize="{DynamicResource UISidebarSectionFontSize}" Cursor="Hand" ToolTip="{DynamicResource TextDragCategory}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderSurface" Background="{StaticResource SurfaceOuter}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0" Padding="10,6">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" ClipToBounds="True" />
                        <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                              HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                        </Path>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource FocusHint}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SurfacePressed}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource FocusOutline}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0">
                <Button x:Name="ExpandFoldersButton" Style="{StaticResource CategoryFolderAction}" Click="ExpandCategoryFoldersClick"
                        ToolTip="{DynamicResource TextExpandCategoryFoldersTooltip}" AutomationProperties.Name="{DynamicResource TextExpandCategoryFolders}">
                  <Image Tag="{StaticResource ExpandCategoryFoldersHighlightIcon}">
                    <Image.Style><Style TargetType="Image" BasedOn="{StaticResource CategoryFolderActionIcon}"><Setter Property="Source" Value="{StaticResource ExpandCategoryFoldersIcon}" /></Style></Image.Style>
                  </Image>
                </Button>
                <Button x:Name="CollapseFoldersButton" Style="{StaticResource CategoryFolderAction}" Click="CollapseCategoryFoldersClick"
                        ToolTip="{DynamicResource TextCollapseCategoryFoldersTooltip}" AutomationProperties.Name="{DynamicResource TextCollapseCategoryFolders}">
                  <Image Tag="{StaticResource CollapseCategoryFoldersHighlightIcon}">
                    <Image.Style><Style TargetType="Image" BasedOn="{StaticResource CategoryFolderActionIcon}"><Setter Property="Source" Value="{StaticResource CollapseCategoryFoldersIcon}" /></Style></Image.Style>
                  </Image>
                </Button>
              </StackPanel>
              </Grid>
              <controls:AnimatedDisclosure IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer x:Name="CategoryScroll" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="FolderTreeMouseWheel" ScrollChanged="CategoryScrollChanged">
                <ContentPresenter x:Name="SectionContent" ContentSource="Content" Margin="0,4,0,0" RequestBringIntoView="SidebarHeaderRequestBringIntoView"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ScrollViewer>
              </controls:AnimatedDisclosure>
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DirectoryTreeExpander" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="19" /><Setter Property="Height" Value="20" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <Border Background="{StaticResource SurfaceMiddle}" Width="10" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Muted}" StrokeThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Accent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="CategoryMenuHeader"><TextBlock Text="{Binding}" /></DataTemplate>
    <ContextMenu x:Key="BuiltInCategoryContextMenu" Opened="CategoryContextOpened">
      <MenuItem Tag="ExpandCategoryFolders" Header="{DynamicResource TextExpandCategoryFolders}" Click="ExpandCategoryFoldersClick" />
      <MenuItem Tag="CollapseCategoryFolders" Header="{DynamicResource TextCollapseCategoryFolders}" Click="CollapseCategoryFoldersClick" />
    </ContextMenu>
    <Style x:Key="RenameLabel" TargetType="TextBlock">
      <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="RenameEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Visibility" Value="Collapsed" /><Setter Property="Padding" Value="2,0" />
      <Setter Property="MinWidth" Value="100" /><Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style>
    <HierarchicalDataTemplate x:Key="SidebarFolderNodeTemplate" ItemsSource="{Binding Children}">
      <Grid ToolTip="{Binding FullPath}" ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0" controls:SidebarPathColumns.IsEnabled="{Binding ShowBookmarkPaths, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ChildPathColumn" Width="0" /></Grid.ColumnDefinitions>
        <controls:ShellIcon Path="{Binding FullPath}" VersionStatus="{Binding VersionStatus}" IsDirectory="True" OpenFolder="{Binding IsExpanded}" HideWhenEmpty="True" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RenameLabel}" FontSize="{DynamicResource UIFontSidebar}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Style="{StaticResource RenameEditor}" FontSize="{DynamicResource UIFontSidebar}" IsVisibleChanged="InlineRenameVisibleChanged" LostKeyboardFocus="InlineRenameLostFocus" />
        <TextBlock x:Name="TreeFolderPath" Grid.Column="2" Style="{StaticResource SidebarFolderPath}" />
      </Grid>

    </HierarchicalDataTemplate>
    <Style x:Key="SidebarFolderChildren" TargetType="TreeView">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Tag" Value="SidebarFolderChildren" />
      <Setter Property="ItemsSource" Value="{Binding Node.Children}" />
      <Setter Property="ItemTemplate" Value="{StaticResource SidebarFolderNodeTemplate}" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="19,0,0,0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <EventSetter Event="SelectedItemChanged" Handler="SidebarChildTreeSelectedItemChanged" />
      <EventSetter Event="PreviewMouseWheel" Handler="FolderTreeMouseWheel" />
    </Style>
    <ContextMenu x:Key="FolderTreeContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="FolderTreeContextOpened">
      <MenuItem Tag="ExpandAllSubfolders" Header="{DynamicResource TextExpandAllSubfolders}" Click="ExpandAllSubfoldersClick" />
      <MenuItem Tag="CollapseAllSubfolders" Header="{DynamicResource TextCollapseAllSubfolders}" Click="CollapseAllSubfoldersClick" />
      <Separator />
      <MenuItem Tag="NewFolder" Header="{DynamicResource TextNewFolder}" Click="NewTreeFolderClick" />
    </ContextMenu>
    <Style TargetType="TreeViewItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ContextMenu" Value="{StaticResource FolderTreeContextMenu}" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="Padding" Value="3,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="ToolTip" Value="{Binding FullPath}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="0" /><Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition x:Name="TreeHeaderColumn" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <controls:TreeBranchLines x:Name="BranchLines" Grid.RowSpan="2" HeaderHeight="{Binding ActualHeight, ElementName=PART_Header}" IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ChildCount="{Binding Items.Count, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False" />
            <ToggleButton x:Name="Expander" Style="{StaticResource DirectoryTreeExpander}" VerticalAlignment="Center"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" />
            <Border x:Name="PART_Header" Grid.Column="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" RequestBringIntoView="SidebarHeaderRequestBringIntoView">
              <ContentPresenter x:Name="HeaderHost" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <controls:AnimatedDisclosure x:Name="ItemsReveal" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                         IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
              <ItemsPresenter x:Name="ItemsHost" />
            </controls:AnimatedDisclosure>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowBookmarkPaths, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter TargetName="TreeHeaderColumn" Property="Width" Value="*" /><Setter TargetName="PART_Header" Property="Grid.ColumnSpan" Value="2" />
            </DataTrigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True"><Setter TargetName="PART_Header" Property="Background" Value="{StaticResource SidebarHover}" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="PART_Header" Property="Background" Value="{StaticResource TreeSelected}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
      <EventSetter Event="Expanded" Handler="TreeItemExpanded" />
      <EventSetter Event="Selected" Handler="TreeItemSelected" />
      <EventSetter Event="RequestBringIntoView" Handler="SidebarHeaderRequestBringIntoView" />
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource TreeSelected}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FileMetadataText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SearchTipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{StaticResource HighlightText}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SearchTipCommand" TargetType="TextBlock" BasedOn="{StaticResource SearchTipText}"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
    <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
      <Setter Property="Width" Value="5" /><Setter Property="Background" Value="Transparent" /><Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ColumnFitContextMenu" TargetType="ContextMenu">
      <Setter Property="FontSize" Value="{DynamicResource UIFontMenus}" /><Setter Property="Padding" Value="2" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{StaticResource SurfaceInner}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <EventSetter Event="ContextMenuOpening" Handler="ColumnHeaderContextOpening" />
      <Setter Property="ContextMenu"><Setter.Value><ContextMenu /></Setter.Value></Setter>
      <Setter Property="Background" Value="{StaticResource SurfaceMiddle}" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontWeight" Value="{DynamicResource UIFontWeight}" />
      <Setter Property="Padding" Value="8,3" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="FontSize" Value="{DynamicResource UIFontHeaders}" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid ClipToBounds="True">
            <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter x:Name="HeaderContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" ClipToBounds="True" />
                <Path x:Name="SortArrow" Grid.Column="1" Data="M 7,13 L 7,1 M 2.5,5.5 L 7,1 L 11.5,5.5" Visibility="Hidden" Width="14" Height="14" Margin="8,0,0,0" Stroke="{StaticResource NeutralIndicator}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource ColumnHeaderGripper}" HorizontalAlignment="Left" />
            <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource ColumnHeaderGripper}" HorizontalAlignment="Right" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible" /><Setter TargetName="SortArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SurfaceHover}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /><Setter TargetName="SortArrow" Property="Stroke" Value="{StaticResource HighlightText}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SurfacePressed}" /><Setter Property="Foreground" Value="{StaticResource HighlightText}" /><Setter TargetName="SortArrow" Property="Stroke" Value="{StaticResource HighlightText}" /></Trigger>
